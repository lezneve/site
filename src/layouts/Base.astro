---
import '../styles/global.css';
const { title, description = 'small software. carefully made.' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
const nav = [['kadr', '/kadr'], ['ryad', '/ryad']];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>
    <script is:inline defer src="/_vercel/insights/script.js"></script>
  </head>
  <body>
    <a class="skip" href="#main">skip to content</a>
    <header class="wrap top">
      <a class="mark" href="/">lezneve</a>
      <nav class="nav" aria-label="main">
        {nav.map(([n, h]) => <a href={h} aria-current={path === h ? 'page' : undefined}>{n}</a>)}
        <a href="https://github.com/lezneve">github</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="wrap foot">
      <span>lezneve. small software. carefully made.</span>
      <div class="group">
        <a href="https://github.com/lezneve">github</a>
        <span>mit licensed · windows 10/11 · x64</span>
        <span>visits are counted without cookies</span>
      </div>
    </footer>
  </body>
</html>
